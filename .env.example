# Binance Demo Trading API credentials
# Get these from: https://demo.binance.com → Account → Demo Trading API
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_secret_key_here

# Binance Futures Demo Base URL
BINANCE_BASE_URL=https://demo-fapi.binance.com

# Optional configuration (these have sensible defaults)
REQUEST_TIMEOUT_CONNECT=5.0
REQUEST_TIMEOUT_READ=10.0
MAX_RETRIES=3
LOG_LEVEL=INFO